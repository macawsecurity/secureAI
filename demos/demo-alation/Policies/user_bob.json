{
  "policy_id": "user:bob",
  "version": "0.3.5",
  "scope": "global",
  "resources": [
    "tool:alation-remote-proxy/run_query_sql_custom_adi",
    "tool:alation-remote-proxy/run_data_product_query_macaw_ii",
    "tool:alation-remote-proxy/run_analytics_agent_macaw",
    "tool:alation-remote-proxy/run_generate_pdf_from_a_chat_macaw",
    "tool:openai-service/generate",
    "tool:anthropic-service/generate"
  ],
  "extends": "bu:analytics",
  "constraints": {
    "attestations": {
      "eng_comp_update_attestation": {
        "approval_criteria": "role:admin",
        "description": "Admin UPDATE on eng_comp -- requires an admin to attest",
        "one_time": true,
        "time_to_live": 300,
        "timeout": 300
      }
    },
    "parameters": {
      "tool:alation-remote-proxy/run_analytics_agent_macaw": {
        "stmt_type": {
          "allowed_values": [
            "select",
            "update"
          ],
          "type": "string"
        }
      },
      "tool:alation-remote-proxy/run_data_product_query_macaw_ii": {
        "stmt_type": {
          "allowed_values": [
            "select",
            "update"
          ],
          "type": "string"
        }
      },
      "tool:alation-remote-proxy/run_query_sql_custom_adi": {
        "stmt_type": {
          "allowed_values": [
            "select",
            "update"
          ],
          "type": "string"
        }
      },
      "tool:anthropic-service/generate": {
        "max_tokens": {
          "max": 100,
          "type": "integer"
        },
        "model": {
          "allowed_values": [
            "claude-sonnet-5"
          ],
          "type": "string"
        }
      },
      "tool:openai-service/generate": {
        "max_tokens": {
          "max": 2000,
          "type": "integer"
        },
        "model": {
          "allowed_values": [
            "gpt-4o-mini",
            "gpt-4o"
          ],
          "type": "string"
        }
      }
    }
  },
  "attestations": [
    "eng_comp_update_attestation::{ params.touches_eng_comp == 'true' AND params.stmt_type == 'update' }"
  ],
  "description": "alice -- role: manager (broader LLM access than alice). Alation: select/update, eng_comp UPDATE attests, DELETE/DDL denied. OpenAI: gpt-4o-mini+gpt-4o, max_tokens<=2000. Anthropic: claude-sonnet-5, max_tokens<=100."
}