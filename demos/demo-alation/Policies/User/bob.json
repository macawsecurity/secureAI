{
  "policy_id": "user:bob",
  "version": "0.6.0",
  "scope": "global",
  "resources": [
    "tool:alation-remote-proxy/run_query_sql_custom_adi",
    "tool:openai-service/generate"
  ],
  "extends": "bu:analytics",
  "constraints": {
    "attestations": {
      "eng_comp_attestation": {
        "approval_criteria": "role:manager",
        "description": "Analyst touched eng_comp -- requires a manager (alice) to attest",
        "one_time": true,
        "time_to_live": 300,
        "timeout": 300
      }
    },
    "parameters": {
      "tool:alation-remote-proxy/run_query_sql_custom_adi": {
        "stmt_type": {
          "allowed_values": [
            "select",
            "update"
          ],
          "type": "string"
        }
      },
      "tool:openai-service/generate": {
        "model": {
          "type": "string",
          "allowed_values": [
            "gpt-4o-mini"
          ]
        },
        "max_tokens": {
          "type": "integer",
          "max": 100
        }
      }
    }
  },
  "attestations": [
    "eng_comp_attestation::{ params.touches_eng_comp == 'true' }"
  ],
  "description": "bob -- role: analyst (narrower LLM access than alice). Any statement touching eng_comp attests to a manager; other tables ungated within the select/update allow-list; DELETE/DDL denied. OpenAI: gpt-4o-mini only, max_tokens<=100."
}
