{
  "policy_id": "user:alice",
  "version": "0.6.0",
  "scope": "global",
  "resources": [
    "tool:alation-remote-proxy/run_query_sql_custom_adi",
    "tool:alation-remote-proxy/run_data_product_query_macaw_ii",
    "tool:alation-remote-proxy/run_analytics_agent_macaw",
    "tool:alation-remote-proxy/run_generate_pdf_from_a_chat_macaw",
    "tool:openai-service/generate",
    "tool:anthropic-service/generate"
  ],
  "extends": "bu:analytics",
  "constraints": {
    "parameters": {
      "tool:alation-remote-proxy/run_analytics_agent_macaw": {
        "stmt_type": {
          "allowed_values": [
            "select",
            "update"
          ],
          "type": "string"
        }
      },
      "tool:alation-remote-proxy/run_data_product_query_macaw_ii": {
        "stmt_type": {
          "allowed_values": [
            "select",
            "update"
          ],
          "type": "string"
        }
      },
      "tool:alation-remote-proxy/run_query_sql_custom_adi": {
        "stmt_type": {
          "allowed_values": [
            "select",
            "update"
          ],
          "type": "string"
        }
      },
      "tool:openai-service/generate": {
        "model": {
          "type": "string",
          "allowed_values": [
            "gpt-4o-mini",
            "gpt-4o"
          ]
        },
        "max_tokens": {
          "type": "integer",
          "max": 2000
        }
      },
      "tool:anthropic-service/generate": {
        "model": {
          "type": "string",
          "allowed_values": [
            "claude-sonnet-5"
          ]
        },
        "max_tokens": {
          "type": "integer",
          "max": 100
        }
      }
    },
    "attestations": {
      "eng_comp_update_attestation": {
        "approval_criteria": "role:manager",
        "description": "Manager UPDATE on eng_comp -- requires an admin (carol) to attest",
        "one_time": true,
        "time_to_live": 300,
        "timeout": 300
      }
    }
  },
  "description": "alice -- role: manager (broader LLM access than bob). Alation: select/update, eng_comp UPDATE attests, DELETE/DDL denied. OpenAI: gpt-4o-mini+gpt-4o, max_tokens<=2000. Anthropic: claude-sonnet-5, max_tokens<=100.",
  "attestations": [
    "eng_comp_update_attestation::{ params.touches_eng_comp == 'true' AND params.stmt_type == 'update' }"
  ]
}
