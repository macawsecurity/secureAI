{
  "policy_id": "user:alice",
  "version": "0.6.1",
  "scope": "global",
  "resources": [
    "tool:alation-remote-proxy/<your-custom-agent-tool-name>",
    "tool:openai-service/generate"
  ],
  "extends": "bu:analytics",
  "constraints": {
    "attestations": {
      "eng_comp_attestation": {
        "approval_criteria": "role:manager",
        "description": "Analyst touched eng_comp -- requires a manager (bob) to attest",
        "one_time": true,
        "time_to_live": 300,
        "timeout": 300
      }
    },
    "parameters": {
      "tool:alation-remote-proxy/<your-custom-agent-tool-name>": {
        "stmt_type": {
          "allowed_values": [
            "select",
            "update"
          ],
          "type": "string"
        }
      },
      "tool:openai-service/generate": {
        "max_tokens": {
          "max": 100,
          "type": "integer"
        },
        "model": {
          "allowed_values": [
            "gpt-4o-mini"
          ],
          "type": "string"
        }
      }
    }
  },
  "attestations": [
    "eng_comp_attestation::{ params.touches_eng_comp == 'true' }"
  ],
  "description": "alice -- role: analyst "
}
