{
  "policy_id": "app:secret-demo",
  "description": "The custom-verifiers examples. A verifier refuses a credential in params.script, a processor masks credentials in the result, and an extractor counts credentials in params.notes for the policy to judge.",
  "scope": "global",
  "version": "1.0",
  "resources": ["tool:secret-demo/**"],
  "extractors": {
    "secrets": {"field": "params.notes"}
  },
  "attestations": [
    "security_review::{ derived.secrets.count == 1 }"
  ],
  "constraints": {
    "attestations": {
      "security_review": {
        "approval_criteria": "role:manager",
        "timeout": 300,
        "time_to_live": 3600,
        "one_time": true,
        "description": "A request whose notes carry one credential"
      }
    },
    "verifiers": {
      "secret_scanner": {
        "priority": 50,
        "enforce": true,
        "fields": ["params.script"]
      }
    },
    "processors": {
      "secret_scrubber": {"enforce": false}
    },
    "denied_parameters": {
      "tool:secret-demo/run": {"notes": ["{derived.secrets.count > 1}"]}
    }
  },
  "verifiers": ["secret_scanner"],
  "processors": ["secret_scrubber"]
}
